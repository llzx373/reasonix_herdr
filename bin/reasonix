#!/usr/bin/env bash
# Wrapper: 启动 Reasonix 时先在 herdr 中预注册 agent 状态
# 这样 Reasonix 一启动 herdr 列表中就能看到，不用等到第一次会话
#
# 由 install.sh 自动生成：{{REAL_REASONIX}} 会被替换为真实路径
# 手动安装时设置 REAL_REASONIX 环境变量
#
# 用法：和正常 reasonix 一模一样
#   reasonix              # 启动
#   reasonix /path/proj   # 在指定项目启动

REAL_REASONIX="{{REAL_REASONIX}}"

# ── 在 herdr 环境中预注册 agent ──
if [ "${HERDR_ENV:-}" = "1" ] && \
   [ -n "${HERDR_PANE_ID:-}" ] && \
   command -v herdr &>/dev/null; then
  herdr pane report-agent "${HERDR_PANE_ID}" \
    --source herdr:reasonix \
    --agent reasonix \
    --state idle 2>/dev/null || true
fi

# ── exec 替换为真实 reasonix ──
exec "$REAL_REASONIX" "$@"
